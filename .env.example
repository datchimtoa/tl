# Required. Revoke the tokens previously committed to the repository first.
SHOP_TOKEN=
ADMIN_TOKEN=
ADMIN_ID=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Allowed characters: A-Z, a-z, 0-9, underscore and hyphen; 1-256 characters.
WEBHOOK_SECRET=
WEBHOOK_BASE_URL=https://your-project.vercel.app

# Required on Vercel: use the writable REST token, not the read-only token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
BOT_STORAGE_KEY=tl:state

# Optional: only needed for the existing Telethon session-checking feature.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional bank settings; existing defaults are preserved.
# BANK_NAME=Vietcombank
# BANK_STK=
# ACCOUNT_NAME=

# Local development only: writable data directory (defaults to tl/ locally).
# BOT_DATA_DIR=/absolute/path/to/data